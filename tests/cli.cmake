function(assert_command status pattern)
    execute_process(COMMAND "${NATHR_BIN}" ${ARGN}
        RESULT_VARIABLE actual OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT actual STREQUAL "${status}")
        message(FATAL_ERROR "${ARGN}: expected exit ${status}, got ${actual}\n${error}")
    endif()
    if(status STREQUAL "0")
        if(NOT output MATCHES "${pattern}" OR NOT error STREQUAL "")
            message(FATAL_ERROR "${ARGN}: unexpected response\n${output}\n${error}")
        endif()
    elseif(NOT error MATCHES "${pattern}" OR NOT output STREQUAL "")
        message(FATAL_ERROR "${ARGN}: unexpected failure response\n${output}\n${error}")
    endif()
    set(command_output "${output}" PARENT_SCOPE)
endfunction()

set(model "${NATHR_FIXTURES}/model/f32")
assert_command(0 "nathr [0-9]+\\.[0-9]+\\.[0-9]+" --version)
assert_command(0 "--kv-cache" --help)
assert_command(0 "--logits-f32" forward --help)
assert_command(1 "unknown command: typo" typo)
assert_command(1 "missing --model" forward)
assert_command(1 "unknown option: --typo" inspect --model "${model}" --typo)
assert_command(1 "duplicate option" inspect --model "${model}" --threads 1 --threads 2)
assert_command(1 "CPU thread count" inspect --model "${model}" --threads 0)
assert_command(1 "invalid number for --tokens" forward --model "${model}" --tokens "1,")
assert_command(1 "require --cached" forward --model "${model}" --tokens 1 --kv-cache f16)
assert_command(0 "greedy_id" forward --model "${model}" --tokens 1,7,2 --cached --kv-cache f16 --threads 2)
assert_command(0 "inter_token_ms" bench --model "${model}" --prompt-length 3 --decode-length 2
               --context 8 --warmups 1 --repetitions 2)
string(JSON ttft GET "${command_output}" ttft_ms median)
string(JSON prefill GET "${command_output}" prefill_ms median)
string(JSON samples LENGTH "${command_output}" decode_samples_ms)
string(JSON intervals GET "${command_output}" inter_token_samples)
if(NOT ttft GREATER 0 OR NOT ttft STREQUAL prefill OR NOT samples EQUAL 2 OR NOT intervals EQUAL 4)
    message(FATAL_ERROR "Unexpected bench timing boundaries or sample counts\n${command_output}")
endif()
