+float q8_int8_dot(const std::byte* weight, std::span<const Q8Activation> blocks) {
+    double sum = 0;
+    for (const auto& b : blocks) {
+        const auto scale = static_cast<double>(half_to_float(read<std::uint16_t>(weight))) * b.scale;
+        sum += scale * int8_dot32(weight + 2, b.codes.data());
