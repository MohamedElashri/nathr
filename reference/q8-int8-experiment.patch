+    const auto paired = [&](std::size_t start) {
+        return _mm256_madd_epi16(
+            _mm256_cvtepi8_epi16(read<__m128i>(weight + start)),
+            _mm256_cvtepi8_epi16(read<__m128i>(reinterpret_cast<const std::byte*>(activation + start))));
